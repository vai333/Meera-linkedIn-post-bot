# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Tried in order; on overload (503) or quota (429) the run moves to the next one.
# Free tier: flash models only. With billing enabled, put gemini-pro-latest first for better posts.
GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-3-flash-preview

# Telegram bot token from @BotFather. Leave blank for dry-run mode (main.py only).
TELEGRAM_BOT_TOKEN=
# Owner's private chat with the bot. Leave blank: the first person to message the bot is paired and saved here.
TELEGRAM_CHAT_ID=

# Extra words for voice-note transcription, comma-separated (people, companies, products)
TRANSCRIBE_VOCABULARY=

RSS_MAX_ITEMS=8

# Vercel only: any long random string; must match the value set_webhook.py registers.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
